{
  "manifest_version": 3,
  "name": "LATO",
  "version": "0.1.1",
  "description": "Read-only local Markdown viewer for Foxbook.",
  "browser_specific_settings": {"gecko": {"id": "lato@foxbook.local", "strict_min_version": "121.0"}},
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "action": {"default_title": "Open LATO"},
  "background": {"scripts": ["background.js"]}
}
